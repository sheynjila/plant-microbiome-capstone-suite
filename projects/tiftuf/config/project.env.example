# Copy this file to project.env, then review it before execution.
PROJECT_CODE=tiftuf
BIOPROJECTS=(PRJNA852645)
PILOT_ASSAY=16S
# Used only when an AMPLICON record does not name 16S or ITS. This default is
# justified by the deposited study scope and remains subject to manifest review.
DEFAULT_AMPLICON_ASSAY=16S

WORKDIR=${WORKDIR:-"$PROJECT_ROOT/work"}
RAW_DIR=${RAW_DIR:-"$WORKDIR/raw_reads"}
OUTPUT_DIR=${OUTPUT_DIR:-"$PROJECT_ROOT/pipeline_raw_reads_to_counts_output"}
REFERENCE_ROOT=${REFERENCE_ROOT:-"$PROJECT_ROOT/references"}

THREADS=${THREADS:-8}
DADA2_N_THREADS=${DADA2_N_THREADS:-8}
MIN_PREVALENCE_SAMPLES=${MIN_PREVALENCE_SAMPLES:-2}
SEED=${SEED:-42}

